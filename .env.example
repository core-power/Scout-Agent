# ============================================================
# Scout Agent 环境配置模板
# 复制为 .env 后填写:  cp .env.example .env
# 安装脚本 install.sh 也会自动生成并引导填写。
# ============================================================

# ── LLM（必填）────────────────────────────────────────────
# 后端推理模型。provider: dashscope / deepseek / zhipu / moonshot / volcano / openai / claude / gemini / openrouter / compatible
# 各 provider 最新模型示例:
#   dashscope: qwen3.8-max | qwen3.7-plus（推荐·多模态）| qwen3.7-flash | qwen3.6-plus
#   deepseek:  deepseek-chat（V4）| deepseek-reasoner（R1）| deepseek-v3.1
#   zhipu:     glm-5.2 | glm-5-plus | glm-5-flash（免费）
#   moonshot:  kimi-k3 | kimi-k2-thinking | kimi-k2
#   volcano:   doubao-1.5-pro-32k | doubao-1.5-pro-256k | doubao-1.5-lite-32k
#   openai:    gpt-4.1 | gpt-4.1-mini | o3 | o4-mini | gpt-4o
#   claude:    claude-sonnet-4-20250514（推荐）| claude-opus-4-20250514（最强）
#   gemini:    gemini-2.5-pro（旗舰）| gemini-2.5-flash
#   openrouter: anthropic/claude-sonnet-4 | openai/gpt-4.1 | google/gemini-2.5-pro
SCOUT_LLM_PROVIDER=dashscope
SCOUT_LLM_MODEL=qwen3.7-plus
SCOUT_LLM_API_KEY=
# 可选: 自定义 OpenAI 兼容端点（provider=compatible 或自建 vLLM/Ollama/PAI-EAS）
# SCOUT_LLM_BASE_URL=
SCOUT_LLM_TEMPERATURE=0.7
SCOUT_LLM_MAX_TOKENS=4096

# ── Embedding（默认纯文本检索，无需本地模型）──────────────
# provider: api（远端接口，需配置 SCOUT_EMBEDDING_API_KEY）
#           hash（内置哈希向量，轻量兜底）
#           留空 = 纯文本检索（默认，无需任何模型/密钥）
SCOUT_EMBEDDING_PROVIDER=
# 若使用 api 模式:
#   a) 云 API（如 DashScope text-embedding-v3）:
#      SCOUT_EMBEDDING_API_KEY=sk-xxx
#      SCOUT_EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#      SCOUT_EMBEDDING_API_MODEL=text-embedding-v3
#   b) 自托管 Embedding Server（tools/embedding_server.py，推荐内网/私有部署）:
#      SCOUT_EMBEDDING_API_KEY=local
#      SCOUT_EMBEDDING_API_BASE_URL=http://127.0.0.1:8849/v1
#      SCOUT_EMBEDDING_API_MODEL=BAAI/bge-small-zh-v1.5
# SCOUT_EMBEDDING_API_KEY=
# SCOUT_EMBEDDING_API_BASE_URL=
# SCOUT_EMBEDDING_API_MODEL=
# SCOUT_EMBEDDING_DIMENSION=1024

# ── 运行时（可选）────────────────────────────────────────
# 数据目录（默认 ~/.scout）: 会话、记忆、usage 统计
# SCOUT_DATA_DIR=~/.scout
SCOUT_LOG_LEVEL=INFO

# ── 高级: 存储后端（不填走默认 SPI/内存）────────────────
# SCOUT_MEMORY_STORE=memory
# SCOUT_CACHE_BACKEND=
# SCOUT_BUS_BACKEND=

# ── 语音（可选，启用语音功能时填写）─────────────────────
# SCOUT_ASR_MODEL=
# SCOUT_TTS_MODEL=

# ── 通知 / 平台（可选，按需启用）────────────────────────
# WECHAT_CORP_ID=
# WECHAT_CORP_SECRET=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
