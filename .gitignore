# ===== 打包产物（spec 是打包配置，保留入库便于复现构建）=====
build/
dist/
ScoutPortable/
!desktop/*.spec

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
